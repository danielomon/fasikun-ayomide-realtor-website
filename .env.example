# Copy this file to .env and fill in your real values.
# .env is already in .gitignore, so it won't be committed by accident.

# --- Email notifications (Resend) ---
# Get a free API key at https://resend.com (no card required).
SERVERFORM_ACCESS_KEY=

# Sender address. Leave as-is to use Resend's shared test sender, which works
# immediately for notifying yourself but can only deliver to the email your
# Resend account was created with. Once you verify your own domain in Resend,
# change this to an address on that domain (e.g. hello@yourdomain.com) so
# auto-replies can reach real visitors too. See README.
SERVERFORM_ACCESS_KEY=

# Where lead notification emails are sent — use the same email you signed up
# to Resend with, so this works immediately without domain verification.
NOTIFY_EMAIL=fasikunayomide3@gmail.com

# Used inside the email templates.
SITE_NAME=Fasikun Ayomide | Realtor

# --- Admin ---
# Protects GET /api/leads and property write endpoints. Change this to something private.
ADMIN_KEY=change-this-admin-key

# --- Server ---
PORT=3000
